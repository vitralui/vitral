{
  "name": "@vitral/forms",
  "version": "0.2.0",
  "description": "Framework-free form state and validation for Vitral: nested paths, field arrays, built-in rules, async validation and structural resolvers for schema libraries.",
  "keywords": [
    "vitral",
    "forms",
    "validation",
    "zod",
    "yup",
    "valibot",
    "superstruct"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/forms"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  }
}
