{
  "name": "@vitral/tour",
  "version": "0.2.11",
  "description": "Framework-free guided tours for Vitral: a highlight and a popover per step, hooks and methods to drive them, conditional steps, waits, steps that advance on their own, progress styles and a tour that remembers where the reader got to.",
  "keywords": [
    "vitral",
    "tour",
    "onboarding",
    "walkthrough",
    "product-tour",
    "highlight"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/tour"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vitral/controls": "workspace:*",
    "@vitral/core": "workspace:*",
    "@vitral/dom": "workspace:*",
    "@vitral/icons": "workspace:*",
    "@vitral/styles": "workspace:*"
  }
}
