{
  "name": "@vitral/chat",
  "version": "0.2.3",
  "description": "Framework-free chat for Vitral: the engine (messages, grouping, streaming, the composer) and a DOM renderer with roving focus and live announcements, which the Vue, React and Angular components wrap.",
  "keywords": [
    "vitral",
    "chat",
    "chatbot",
    "assistant",
    "ai",
    "copilot"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/chat"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vitral/controls": "workspace:*",
    "@vitral/core": "workspace:*",
    "@vitral/dom": "workspace:*",
    "@vitral/icons": "workspace:*",
    "@vitral/styles": "workspace:*"
  }
}
