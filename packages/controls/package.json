{
  "name": "@vitral/controls",
  "version": "0.2.2",
  "description": "Framework-free controls for Vitral addons: an anchored overlay, a listbox select and a menu, built on @vitral/core and @vitral/dom and wearing the Vitral styles.",
  "keywords": [
    "vitral",
    "controls",
    "select",
    "menu",
    "overlay",
    "headless"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/controls"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vitral/core": "workspace:*",
    "@vitral/dom": "workspace:*",
    "@vitral/icons": "workspace:*",
    "@vitral/styles": "workspace:*"
  }
}
