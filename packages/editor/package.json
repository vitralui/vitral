{
  "name": "@vitral/editor",
  "version": "0.1.0",
  "description": "Framework-free rich text editor for Vitral: the toolbar, the panels and the content area over @vitral/core's editor engine, which the Vue, React and Angular components wrap.",
  "keywords": [
    "vitral",
    "editor",
    "rich text",
    "wysiwyg",
    "contenteditable"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/editor"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./buttons": {
      "types": "./dist/buttons.d.ts",
      "import": "./dist/buttons.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vitral/controls": "workspace:*",
    "@vitral/core": "workspace:*",
    "@vitral/dom": "workspace:*",
    "@vitral/icons": "workspace:*",
    "@vitral/styles": "workspace:*"
  }
}
