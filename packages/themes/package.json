{
  "name": "@vitral/themes",
  "version": "0.2.0",
  "description": "Design-token engine and presets (Prism, Ink, Avalonia, Simple) for Vitral.",
  "keywords": [
    "vitral",
    "design-tokens",
    "theme",
    "css-variables",
    "dark-mode",
    "preset"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/themes"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/build-theme-css.mjs"
  },
  "dependencies": {
    "@vitral/core": "workspace:*"
  }
}
