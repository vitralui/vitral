{
  "name": "@vitral/styles",
  "version": "0.2.1",
  "description": "Framework-agnostic component CSS and class maps for Vitral, written against theme tokens.",
  "keywords": [
    "vitral",
    "css",
    "design-tokens",
    "component-css"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/styles"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitral.css": "./dist/vitral.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/bundle-css.mjs"
  },
  "dependencies": {
    "@vitral/core": "workspace:*"
  }
}
