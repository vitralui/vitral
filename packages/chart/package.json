{
  "name": "@vitral/chart",
  "version": "0.1.0",
  "description": "Framework-free SVG charts for Vitral: the engine (scales, scenes, formats, the options schema) and a DOM renderer with interaction and accessibility, which the Vue, React and Angular components wrap.",
  "keywords": [
    "vitral",
    "chart",
    "charts",
    "svg",
    "dataviz",
    "apexcharts-compatible"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/chart"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js"
    },
    "./chart.css": "./dist/chart.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/style/chart.css','dist/chart.css')\""
  },
  "dependencies": {
    "@vitral/core": "workspace:*",
    "@vitral/icons": "workspace:*"
  }
}
