{
  "name": "@vitral/vue",
  "version": "0.2.0",
  "description": "Vitral for Vue 3: components, composables, directives and the plugin that themes them.",
  "keywords": [
    "vitral",
    "vue",
    "vue3",
    "components",
    "component-library",
    "design-tokens",
    "accessibility"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Gustavo Will",
  "homepage": "https://vitralui.github.io/vitral/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitralui/vitral.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/vitralui/vitral/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./manifest": {
      "types": "./dist/components/manifest.d.ts",
      "import": "./dist/components/manifest.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vitral/chart": "workspace:*",
    "@vitral/chat": "workspace:*",
    "@vitral/core": "workspace:*",
    "@vitral/datagrid": "workspace:*",
    "@vitral/dom": "workspace:*",
    "@vitral/editor": "workspace:*",
    "@vitral/forms": "workspace:*",
    "@vitral/icons": "workspace:*",
    "@vitral/schedule": "workspace:*",
    "@vitral/spreadsheet": "workspace:*",
    "@vitral/styles": "workspace:*",
    "@vitral/taskboard": "workspace:*",
    "@vitral/themes": "workspace:*"
  }
}
